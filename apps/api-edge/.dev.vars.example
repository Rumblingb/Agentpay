# ── Required secrets (copy to .dev.vars for local dev) ────────────────────────
# Run: cp .dev.vars.example .dev.vars  then fill in real values

DATABASE_URL="postgresql://..."
WEBHOOK_SECRET="<32+ char random string>"
AGENTPAY_SIGNING_SECRET="<32+ char random string>"
VERIFICATION_SECRET="<32+ char random string>"
ADMIN_SECRET_KEY="<32+ char random string>"

# ── AI (required for Bro concierge + voice) ───────────────────────────────────
# Anthropic: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY="sk-ant-..."

# OpenAI: https://platform.openai.com → API Keys
# Powers Whisper STT and TTS-1 in the voice proxy
OPENAI_API_KEY="sk-..."
# Closed-world commerce reasoning. Allowed: gpt-5.6, gpt-5.6-sol, gpt-5.6-terra, gpt-5.6-luna.
OPENAI_COMMERCE_MODEL="gpt-5.6"

# ── RTT (Realtime Trains) — required for live train schedules ─────────────────
# Register FREE at: https://api.rtt.io (click "Register" → Developer / Free plan)
# You get a username and password immediately after registration.
# Free tier: 500 requests/hour — more than enough for demo.
RTT_USERNAME="rttapi_yourname"
RTT_PASSWORD="your_rtt_password"

# ── Stripe (optional for GBP payments) ───────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Provider-neutral payments (deny-by-default sandbox) ──────────────────────
# Keep live disabled until each provider account, webhook, and compliance review is complete.
AGENTPAY_PAYMENT_MODE="sandbox"
AGENTPAY_LIVE_PAYMENTS_ENABLED="false"
AGENTPAY_PAYMENTS_ENABLED="false"
AGENTPAY_ALLOWED_PAYMENT_PROVIDERS="stripe,airwallex,x402"
AGENTPAY_ALLOWED_PAYMENT_CURRENCIES="USD,GBP,EUR"
AGENTPAY_ALLOWED_PAYMENT_AGENTS=""
AGENTPAY_ALLOWED_PAYMENT_REDIRECT_HOSTS="agentpay.so,app.agentpay.so"
# Generate and store a distinct base64url-encoded 32-byte AES-GCM key outside source control.
# Required before Stripe or Airwallex provider intents become configured.
AGENTPAY_PAYMENT_RESPONSE_ENCRYPTION_KEY=""
AGENTPAY_MAX_PAYMENT_MINOR="10000"
AGENTPAY_MAX_DAILY_PAYMENT_MINOR="50000"

# Dedicated webhook endpoints keep this provider flow isolated from legacy handlers.
STRIPE_PROVIDER_WEBHOOK_SECRET=""
AIRWALLEX_PROVIDER_WEBHOOK_SECRET=""

# Airwallex demo credentials and webhook subscription secret.
AIRWALLEX_CLIENT_ID=""
AIRWALLEX_API_KEY=""
AIRWALLEX_WEBHOOK_SECRET=""
AIRWALLEX_SANDBOX="true"

# x402 is non-custodial: allowlist canonical network/asset IDs and recipient addresses.
# No wallet seed phrase or raw private key belongs in this file or Worker.
AGENTPAY_ALLOWED_CRYPTO_NETWORKS=""
AGENTPAY_ALLOWED_CRYPTO_ASSETS=""
AGENTPAY_ALLOWED_CRYPTO_RECIPIENTS=""

# Visa remains disabled until Visa Acceptance/Cybersource enables a concrete product.
VISA_CYBERSOURCE_MERCHANT_ID=""
VISA_CYBERSOURCE_KEY_ID=""
VISA_CYBERSOURCE_SHARED_SECRET=""

RESEND_API_KEY="re_..."
