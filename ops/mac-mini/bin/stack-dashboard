#!/usr/bin/env bash
export PATH="/opt/homebrew/bin:$PATH"
set -euo pipefail

# Ensure required directories and files exist
mkdir -p ${HOME}/.openclaw/workspace-bill
mkdir -p ${HOME}/.openclaw/workspace-agency-os
mkdir -p ${HOME}/.openclaw/workspace-bill/memory

touch ${HOME}/.openclaw/workspace-bill/OUTBOX.md
touch ${HOME}/.openclaw/workspace-agency-os/OUTBOX.md

base_dir="$(cd -- "$(dirname -- "$0")" && pwd)"

# Run monitoring components in background
"$base_dir/stack-watch" 10 &
"$base_dir/stack-activity-watch" 10 &
"$base_dir/stack-openclaw-watch" 20 &
wait
