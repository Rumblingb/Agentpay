{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(jq:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push -u origin:*)",
      "Bash(git stash:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm ci:*)",
      "Bash(npm install:*)",
      "Bash(npm audit:*)",
      "Bash(npx tsc:*)",
      "Bash(npx jest:*)",
      "Bash(npx eslint:*)",
      "Bash(npx wrangler dev:*)",
      "Bash(npx wrangler tail:*)",
      "Bash(npx wrangler secret list:*)",
      "Bash(npx eas secret:list:*)",
      "Bash(node scripts/:*)",
      "Bash(curl -s https://api.agentpay.so/:*)"
    ],
    "ask": [
      "Bash(npx wrangler deploy:*)",
      "Bash(npx wrangler secret put:*)",
      "Bash(npx vercel:*)",
      "Bash(npx eas build:*)",
      "Bash(npx eas submit:*)",
      "Bash(npx prisma migrate:*)",
      "Bash(psql:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(npx wrangler secret delete:*)",
      "Bash(npx wrangler delete:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.dev.vars)",
      "Read(./**/*.pem)",
      "Read(./**/*.p8)",
      "Read(./**/*.keystore)"
    ]
  },
  "env": {
    "NODE_OPTIONS": "--max-old-space-size=4096"
  }
}
